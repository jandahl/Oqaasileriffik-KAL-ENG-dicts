{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["meta", "by_category", "flat"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schema_version", "generated_at"]
    },
    "by_category": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "$ref": "#/$defs/morpheme" }
      }
    },
    "flat": {
      "type": "array",
      "items": { "$ref": "#/$defs/morpheme" }
    }
  },
  "$defs": {
    "morpheme": {
      "type": "object",
      "required": ["id", "category"],
      "properties": {
        "id":       { "type": "string" },
        "category": { "type": "string" },
        "lexical_facts": {
          "type": "object",
          "properties": {
            "morpheme_type":  { "type": "string" },
            "word_class":     { "type": "string" },
            "category_shift": { "type": "string" },
            "valency":        { "enum": ["transitive", "intransitive", "ambitransitive"] },
            "meaning":        { "type": "string" }
          }
        },
        "application_logic": {
          "type": "object",
          "properties": {
            "underlying_form":    { "type": "string" },
            "boundary_behavior":  { "enum": ["truncating", "additive", "assimilative", "none"] },
            "continuation_class": { "type": "string" },
            "notes": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "pedagogy": {
          "type": "object",
          "properties": {
            "note": { "type": "string" },
            "examples": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["surface", "natural"],
                "properties": {
                  "surface":  { "type": "string" },
                  "natural":  { "type": "string" }
                }
              }
            }
          }
        },
        "provenance": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
